# Postgres connection string (Neon / Supabase / local docker)
DATABASE_URL=postgres://mono:mono@localhost:5432/mono
# Secret used to sign session JWTs (openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# API key required by POST /api/ingest (used by the external simulator)
INGEST_API_KEY=dev-ingest-key
# true = the server itself generates the virtual PLC stream lazily (needed on Vercel, which has no worker)
EMBEDDED_SIMULATOR=true
# Raw 20 ms readings older than this are pruned (1 s rollups + +-60 s around every alert are kept). 1 h keeps a free-tier DB < ~300 MB
RAW_RETENTION_HOURS=1
